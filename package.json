{
  "name": "dsh-local-3d-studio",
  "version": "0.3.1",
  "description": "DeepSeek Harness 本地三维工作室：硬件与工具实测探测、文本/图片/视频输入、样例审查、模型与动画渲染；内置 Three.js 程序化生成、模型修改、离线预览页与多视角截图，无需 Blender。",
  "keywords": [
    "dsh",
    "ai",
    "3d",
    "three.js",
    "gltf",
    "blender",
    "model-editing",
    "procedural",
    "render"
  ],
  "type": "module",
  "main": "index.mjs",
  "exports": {
    ".": "./index.mjs"
  },
  "files": [
    "index.mjs",
    "cordis.patch.yml",
    "src",
    "workers",
    "assets",
    "viewer",
    "examples",
    "docs",
    "scripts",
    "recipes",
    "tests",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.1-rc.1 <0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.1 <0.3.0",
    "@deepseek-ai/dsh-mcp-client": ">=0.2.1-rc.1 <0.3.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-mcp-client": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node --test tests/core.test.mjs",
    "package": "python scripts/package.py"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RoderickWilliams/dsh-local-3d-studio.git"
  },
  "homepage": "https://github.com/RoderickWilliams/dsh-local-3d-studio#readme",
  "bugs": {
    "url": "https://github.com/RoderickWilliams/dsh-local-3d-studio/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
